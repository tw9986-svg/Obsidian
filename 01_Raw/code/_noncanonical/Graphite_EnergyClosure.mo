within MSRE.Verification;
package BaseClasses "Support components used only by verification models"
  extends Modelica.Icons.BasesPackage;
  annotation (Documentation(info="<html>
<p>Components here exist to make verification and diagnostic models possible. They are
<b>not</b> part of the MSRE plant model and must not appear in a benchmark result.</p>
</html>"));
end BaseClasses;
